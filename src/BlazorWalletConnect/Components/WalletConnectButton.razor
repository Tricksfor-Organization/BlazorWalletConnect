@using BlazorWalletConnect.Services
@using Microsoft.AspNetCore.Components.Web
@inject IWalletConnectInterop _walletConnectInterop

@if (string.IsNullOrEmpty(Label))
{
    <appkit-connect-button 
        size=@(Size is Models.ConnectButtonOptions.ButtonSize.Small ? "sm" : "md")/>
}
else
{
    <appkit-button label=@Label balance=@(ShowBalance ? "show" : "hide") 
        size=@(Size is Models.ConnectButtonOptions.ButtonSize.Small ? "sm" : "md") />
}

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool ShowBalance { get; set; } = true;

    [Parameter]
    public Models.ConnectButtonOptions.ButtonSize Size { get; set; } = Models.ConnectButtonOptions.ButtonSize.Medium;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await _walletConnectInterop.ConfigureAsync();
            StateHasChanged();
        }
    }
}
