@using BlazorWalletConnect.Services
@using Microsoft.AspNetCore.Components.Web
@inject IWalletConnectInterop _walletConnectInterop

@if (string.IsNullOrEmpty(Label))
{
    <appkit-connect-button
        class=@CssClass
        style=@ButtonStyle
        size=@(Size is Models.ConnectButtonOptions.ButtonSize.Small ? "sm" : "md")/>
}
else
{
    <appkit-button
        class=@CssClass
        style=@ButtonStyle
        label=@Label
        balance=@(ShowBalance ? "show" : "hide")
        size=@(Size is Models.ConnectButtonOptions.ButtonSize.Small ? "sm" : "md") />
}

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool ShowBalance { get; set; } = true;

    [Parameter]
    public Models.ConnectButtonOptions.ButtonSize Size { get; set; } = Models.ConnectButtonOptions.ButtonSize.Medium;

    /// <summary>
    /// Gets or sets the disconnected connect button background color without changing the AppKit modal accent.
    /// Any valid CSS color value is supported.
    /// </summary>
    [Parameter]
    public string? ButtonColor { get; set; }

    /// <summary>
    /// Gets or sets a CSS class applied to the AppKit component host.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string? ButtonStyle => string.IsNullOrWhiteSpace(ButtonColor)
        ? null
        : $"--apkt-tokens-core-backgroundAccentPrimary: {ButtonColor.Trim()};";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await _walletConnectInterop.ConfigureAsync();
            StateHasChanged();
        }
    }
}
