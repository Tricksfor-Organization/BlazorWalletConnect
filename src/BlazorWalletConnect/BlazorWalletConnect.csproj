<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Tricksfor.BlazorWalletConnect</AssemblyName>
		<!-- Include README in the generated NuGet package and set repository/project links -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Tricksfor-Organization/BlazorWalletConnect</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/Tricksfor-Organization/BlazorWalletConnect</PackageProjectUrl>
		<Authors>Tricksfor Organization</Authors>
		<Description>Blazor WalletConnect integration for multi-chain Web3 applications. Supports Ethereum, Polygon, Arbitrum, Optimism, BSC, Avalanche and more. Includes wallet connection, signing, transactions, NFT operations, and event handling.</Description>
		<DefaultItemExcludes>$(DefaultItemExcludes);Npm\**\*;tsconfig.json;Properties\launchSettings.json</DefaultItemExcludes>
	</PropertyGroup>
	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

    <ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Nethereum.Contracts" />
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>

	<ItemGroup>
		<WalletConnectAssetSource Include="Npm/src/**/*.ts;Npm/tests/**/*.ts;Npm/package.json;Npm/package-lock.json;tsconfig.json" />
	</ItemGroup>

	<Target Name="RestoreWalletConnectNpmPackages"
		Inputs="Npm/package.json;Npm/package-lock.json"
		Outputs="Npm/node_modules/.package-lock.json">
		<Exec Command="npm ci" WorkingDirectory="Npm" />
	</Target>

	<Target Name="BuildWalletConnectAssets"
		BeforeTargets="PrepareForBuild"
		DependsOnTargets="RestoreWalletConnectNpmPackages"
		Inputs="@(WalletConnectAssetSource)"
		Outputs="$(IntermediateOutputPath)walletconnect-assets-$(Configuration).stamp;wwwroot/Tricksfor.WalletConnect.bundle.js">
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<Exec Command="npm run typecheck" WorkingDirectory="Npm" />
		<Exec Command="npm test" WorkingDirectory="Npm" />
		<Exec Command="npm run buildDebug" WorkingDirectory="Npm" Condition="'$(Configuration)' == 'Debug'" />
		<Exec Command="npm run build" WorkingDirectory="Npm" Condition="'$(Configuration)' == 'Release'" />
		<Touch Files="$(IntermediateOutputPath)walletconnect-assets-$(Configuration).stamp" AlwaysCreate="true" />
	</Target>

</Project>
