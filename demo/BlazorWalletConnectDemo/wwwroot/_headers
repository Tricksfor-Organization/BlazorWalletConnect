# Cloudflare Pages Headers Configuration for Blazor PWA

# Security Headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# index.html - never cache, always revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Service Worker - never cache to ensure updates
/service-worker.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Service-Worker-Allowed: /

# Service Worker Assets - short cache for version checking
/service-worker-assets.js
  Content-Type: application/javascript
  Cache-Control: max-age=300, must-revalidate

# Web Manifest - short cache but revalidate
/manifest.webmanifest
  Cache-Control: max-age=3600, must-revalidate
  Content-Type: application/manifest+json

# WebAssembly files - long cache with correct MIME type
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

# DLL files - long cache
/*.dll
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

# JavaScript files from _framework - long cache (fingerprinted)
/_framework/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript

# JavaScript files from _content - long cache (fingerprinted)
/_content/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript

# JavaScript files from _content/**/ - long cache (fingerprinted)
/_content/**/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript

# JSON files - moderate cache
/*.json
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/json

# CSS files - long cache (usually fingerprinted)
/*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css

# Font files - long cache
/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2

# Image files - long cache
/*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/*.gif
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/gif

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/*.ico
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/x-icon

# Data files (Blazor specific)
/*.dat
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/*.blat
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

# PWA Icons - long cache
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

# API routes - never cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
